<div id="toast"></div>

<script>
// ---- Product data (mirrors the reference store) ----
const products = [
  {name:"F7 Desktop And Wall-Mounted Circulation Fan With An LED Digital Display", price:1799, old:null, emoji:"🌀"},
  {name:"KH-740 Fascial Massage Gun", price:1399, old:null, emoji:"💆"},
  {name:"Ramadan Retro LED Lamp Electronic Night Light", price:450, old:750, emoji:"💡"},
  {name:"Electronic Digital Table Clock🕰️", price:1099, old:1350, emoji:"⏰"},
  {name:"Auto Eject Charger", price:750, old:999, emoji:"🔌"},
  {name:"Three-Head Fascial Gun", price:1399, old:1599, emoji:"💆"},
  {name:"LED Candle 3pc Set✨✨", price:899, old:1099, emoji:"🕯️"},
  {name:"Ice Mist Air Conditioning Cooling Fan", price:1799, old:2200, emoji:"🌀"},
  {name:"Purple And Gray F6 Desktop Air Circulation Fan With A Digital Battery Display", price:1700, old:2300, emoji:"🌀"},
  {name:"Mini Thermal Bluetooth Printer With Paper Roll", price:1899, old:2300, emoji:"🖨️"},
  {name:"Mordarn Wood Style Table Lamp", price:1399, old:1899, emoji:"💡"},
  {name:"Bladeless Mini High-Speed Desktop Fan With 3 Speeds", price:999, old:1399, emoji:"🌀"},
  {name:"Premium High Speed Small Wind Cannon Turbine", price:1099, old:1599, emoji:"🌀"},
  {name:"Apple Airpods Pro 2nd Generation (Black)", price:999, old:1499, emoji:"🎧"},
  {name:"FRB N-27 Smart Wireless Neckband-400 Hours", price:1199, old:1499, emoji:"🎧"},
];

const grid = document.getElementById('productGrid');
const fmt = n => 'Tk ' + n.toLocaleString('en-US');
let cartCount = 0;

function render(list){
  grid.innerHTML = list.map((p, i) => `
    <div class="card">
      <div class="card-media">
        ${p.old ? `<span class="badge">সাশ্রয় ${p.old - p.price} BDT</span>` : ''}
        <span class="emoji">${p.emoji}</span>
      </div>
      <div class="card-body">
        <div class="card-title">${p.name}</div>
        <div class="price-row">
          <span class="price-now">${fmt(p.price)}</span>
          ${p.old ? `<span class="price-old">${fmt(p.old)}</span>` : ''}
        </div>
        <div class="card-actions">
          <button class="btn ghost" data-action="cart" data-idx="${i}">কার্টে যোগ</button>
          <button class="btn solid" data-action="order" data-idx="${i}">অর্ডার করুন</button>
        </div>
      </div>
    </div>
  `).join('');
}

render(products);

document.getElementById('sortSelect').addEventListener('change', e => {
  const v = e.target.value;
  let list = [...products];
  if (v === 'low-high') list.sort((a,b)=>a.price-b.price);
  if (v === 'high-low') list.sort((a,b)=>b.price-a.price);
  render(list);
});

grid.addEventListener('click', e => {
  const btn = e.target.closest('button[data-action]');
  if (!btn) return;
  const idx = btn.dataset.idx;
  const name = products[idx].name;
  if (btn.dataset.action === 'cart') {
    cartCount++;
    document.getElementById('cartCount').textContent = cartCount;
    showToast(name + ' কার্টে যোগ করা হয়েছে');
  } else {
    showToast(name + ' — অর্ডার প্রক্রিয়া শুরু হবে');
  }
});

let toastTimer;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 2200);
}
</script>
